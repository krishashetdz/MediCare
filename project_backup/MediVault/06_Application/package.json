{
  "name": "medicare-app",
  "version": "1.0.0",
  "description": "MediCare Smart Hospital & Emergency Management System - Node/Express + MySQL + MongoDB",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "db:install": "node db/install-fresh.js",
    "db:migrate": "node db/migrate.js",
    "db:migrate:status": "node db/migrate.js --status",
    "db:backup": "node db/backup.js",
    "test": "node test-e2e.js",
    "test:browser": "python3 tests/test-browser-e2e.py"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-async-errors": "^3.1.1",
    "express-session": "^1.18.0",
    "mongodb": "^6.7.0",
    "mysql2": "^3.10.0"
  }
}
