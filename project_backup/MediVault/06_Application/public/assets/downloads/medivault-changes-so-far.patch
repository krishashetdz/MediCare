+const {requireRole}=require('../middleware/auth');
+
+router.get('/blood-bank',requireRole('Admin','Doctor','Nurse'),async(req,res)=>{
+    const [rows]=await mysqlPool.query('SELECT blood_id,blood_group,units_available,last_updated FROM BLOOD_BANK ORDER BY blood_group');
