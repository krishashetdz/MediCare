# MySQL / MariaDB connection settings (primary transactional relational database)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=medivault
# Optional Unix socket path for local MariaDB/MySQL (leave blank to use TCP host/port)
# MYSQL_SOCKET=/var/run/mysqld/mysqld.sock

# MongoDB connection URI (stores lab_reports_raw, audit_log, ambulance_dispatch_log, notification_log)
MONGO_URI=mongodb://localhost:27017

# Session secret (server.js refuses to start with placeholder values like 'change-this-in-production').
# Generate a strong random secret with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# or:
#   openssl rand -hex 48
SESSION_SECRET=replace-with-a-long-random-string

# HTTP server port
PORT=3000
